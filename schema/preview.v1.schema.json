{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "badil.dev/v1"
    },
    "services": {
      "items": {
        "properties": {
          "name": {
            "type": "string"
          },
          "repoURL": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "commitSha": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "metadata": {
            "properties": {
              "pr-author": {
                "type": "string"
              },
              "pr-url": {
                "type": "string"
              },
              "pr-number": {
                "type": "string"
              },
              "created-at": {
                "type": "string"
              },
              "updated-at": {
                "type": "string"
              },
              "vcs.ref.name": {
                "type": "string"
              },
              "cicd.pipeline.run.url": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "pr-author",
              "pr-url",
              "pr-number",
              "created-at",
              "updated-at",
              "vcs.ref.name",
              "cicd.pipeline.run.url"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "repoURL",
          "branch"
        ],
        "dependentRequired": {
          "commitSha": [
            "metadata"
          ],
          "metadata": [
            "commitSha"
          ]
        }
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiVersion",
    "services"
  ]
}
